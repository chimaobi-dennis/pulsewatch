{
  "name": "pulsewatch",
  "version": "0.1.0",
  "description": "Self-hosted uptime monitor and static status page. Checks HTTP, TCP and TLS expiry, stores history as plain files, renders a status page you can host anywhere.",
  "license": "MIT",
  "author": "Chimaobi Dennis <igsoftwebstudio@gmail.com>",
  "repository": { "type": "git", "url": "https://github.com/chimaobi-dennis/modal-flow-form" },
  "keywords": ["uptime", "monitoring", "status-page", "health-check", "ssl-expiry", "self-hosted"],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "pulsewatch": "./dist/cli/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "check": "tsx src/cli/index.ts check",
    "generate": "tsx src/cli/index.ts generate",
    "serve": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
